<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localization_bringup</name>
  <version>0.1.0</version>
  <description>Launch NDT localization (pcl_localization_ros2) and EKF (ekf_localizer) with per-environment settings</description>
  <maintainer email="g2581059@tcu.ac.jp">maehara</maintainer>
  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>pcl_localization_ros2</exec_depend>
  <exec_depend>ekf_localizer</exec_depend>
  <exec_depend>whill_odometry</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
